{
    "name": "Rust Dev (DinD)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "enableNonRootDocker": true,
            "moby": false
        }
    },
    "runArgs": [
        "--privileged",
        "--init"
    ],
    "mounts": [
        "type=volume,source=dind-var-lib-docker,target=/var/lib/docker"
    ],
    "postCreateCommand": "sudo /usr/local/share/docker-init.sh && echo '{}' > ~/.docker/config.json || true && echo 'alias dagger=\"env -u GIT_ASKPASS -u SSH_ASKPASS -u SSH_AUTH_SOCK dagger\"' >> ~/.bashrc && source ~/.bashrc",
    "customizations": {
        "vscode": {
            "settings": {
                "lldb.executable": "/usr/bin/lldb",
                "rust-analyzer.check.command": "clippy",
                "remote.downloadExtensionsLocally": true,
                "editor.formatOnSave": true
            },
            "extensions": [
                "rust-lang.rust-analyzer",
                "mads-hartmann.bash-ide-vscode",
                "streetsidesoftware.code-spell-checker",
                "tamasfe.even-better-toml",
                "waderyan.gitblame",
                "github.vscode-github-actions"
            ]
        }
    },
    "remoteUser": "vscode"
}